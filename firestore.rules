rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/accounts/$(uid);
    }

    function invitePath(inviteToken) {
      return /databases/$(database)/documents/client_invites/$(inviteToken);
    }

    function hasAccount() {
      return signedIn() && exists(accountPath(request.auth.uid));
    }

    function accountData() {
      return get(accountPath(request.auth.uid)).data;
    }

    function accountRole() {
      return hasAccount() ? accountData().role : null;
    }

    function isCanonicalRole(role) {
      return role in ["admin", "client"];
    }

    function isAdmin() {
      return accountRole() == "admin";
    }

    function isClientRole(role) {
      return role == "client";
    }

    function isArchivedClientData(clientData) {
      return clientData.is_archived == true
        || clientData.status == "Archived"
        || clientData.status == "archived";
    }

    function isOwnAccount(accountId) {
      return signedIn() && accountId == request.auth.uid;
    }

    function claimedInviteMatches(inviteToken, clientId) {
      return inviteToken is string
        && existsAfter(invitePath(inviteToken))
        && getAfter(invitePath(inviteToken)).data.status == "claimed"
        && getAfter(invitePath(inviteToken)).data.claimedByUid == request.auth.uid
        && getAfter(invitePath(inviteToken)).data.clientId == clientId
        && getAfter(invitePath(inviteToken)).data.expiresAt is timestamp
        && request.time < getAfter(invitePath(inviteToken)).data.expiresAt;
    }

    function isClientSelfAccountWrite(accountId) {
      return isOwnAccount(accountId)
        && request.resource.data.account_id == request.auth.uid
        && isClientRole(request.resource.data.role)
        && request.resource.data.clientId is string
        && claimedInviteMatches(
          request.resource.data.clientInviteToken,
          request.resource.data.clientId
        );
    }

    function accountInviteToken() {
      return "staffInviteToken" in request.resource.data
        ? request.resource.data.staffInviteToken
        : (
          "inviteToken" in request.resource.data
            ? request.resource.data.inviteToken
            : null
        );
    }

    function isPendingAdminInviteToken(inviteToken) {
      return inviteToken is string
        && exists(invitePath(inviteToken))
        && get(invitePath(inviteToken)).data.status == "pending"
        && get(invitePath(inviteToken)).data.role == "admin";
    }

    function isAdminInviteAccountWrite(accountId) {
      // A new admin account can only self-create when tied to an unused
      // role-bound client_invites token generated by the admin invite screen.
      return isOwnAccount(accountId)
        && request.resource.data.account_id == request.auth.uid
        && request.resource.data.role == "admin"
        && request.resource.data.email is string
        && isPendingAdminInviteToken(accountInviteToken());
    }

    function isSafeSelfAccountUpdate(accountId) {
      return isOwnAccount(accountId)
        && resource.data.account_id == request.auth.uid
        && request.resource.data.account_id == resource.data.account_id
        && request.resource.data.role == resource.data.role
        && request.resource.data.clientId == resource.data.clientId;
    }

    function isCanonicalAdminAccountWrite() {
      return isAdmin()
        && (!("role" in request.resource.data)
          || isCanonicalRole(request.resource.data.role));
    }

    function isInviteClaim(inviteToken) {
      return signedIn()
        && (!("status" in resource.data) || resource.data.status == "pending")
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.status == "claimed"
        && request.resource.data.claimedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "claimedByUid", "claimedAt"]);
    }

    function isUnexpiredInviteRead() {
      return resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
    }

    function isInvitationLifecycleClaim(tokenId) {
      // Invitation claims may only stamp lifecycle ownership fields on the
      // single invite document addressed by the unguessable route token. Both
      // legacy snake_case and active client_invites camelCase stamps are
      // accepted so the same lifecycle contract protects both collections.
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys
          .hasOnly(["status", "claimed_at", "uid", "tokenId"])
        && (!("status" in resource.data) || resource.data.status == "pending")
        && request.resource.data.status == "claimed"
        && request.resource.data.tokenId == tokenId
        && (!("tokenId" in resource.data) || resource.data.tokenId == tokenId)
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && (!signedIn() || request.resource.data.uid == request.auth.uid)
        && (!("expiresAt" in resource.data)
          || (resource.data.expiresAt is timestamp
            && request.time < resource.data.expiresAt))
      || changedKeys.hasOnly(["status", "claimedByUid", "claimedAt"])
        && (!("status" in resource.data) || resource.data.status == "pending")
        && request.resource.data.status == "claimed"
        && request.resource.data.claimedByUid is string
        && request.resource.data.claimedByUid.size() > 0
        && request.resource.data.claimedByUid.size() <= 128
        && (!signedIn() || request.resource.data.claimedByUid == request.auth.uid)
        && (!("clientId" in request.resource.data)
          || request.resource.data.clientId == resource.data.clientId)
        && (!("expiresAt" in resource.data)
          || (resource.data.expiresAt is timestamp
            && request.time < resource.data.expiresAt));
    }

    function isOneWayAdminClientUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
        || (
          resource.data.status == "interested"
          && request.resource.data.status == "invited"
        )
        || (
          resource.data.status == "invited"
          && request.resource.data.status == "invited"
        )
        || (
          resource.data.status == "registered"
          && request.resource.data.status == "registered"
        );
    }

    function isMappedClientAccount(clientId) {
      return hasAccount()
        && isClientRole(accountData().role)
        && accountData().clientId == clientId;
    }

    function isMappedClient(clientId) {
      return isMappedClientAccount(clientId)
        && !isArchivedClientData(resource.data);
    }

    function isClientProfileUpdate(clientId) {
      return isMappedClient(clientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "first_name",
          "last_name",
          "email",
          "phone",
          "passport_id",
          "gender",
          "address",
          "dob",
          "referrer",
          "education_status",
          "diagnosis",
          "personal_notes",
          "passport_country",
          "citizenship",
          "date_of_entry",
          "purpose_of_visit",
          "home_address",
          "household_members",
          "dependents",
          "medical_profile",
          "contacts",
          "questionnaire",
          "legal_consents",
          "custom_fields",
          "client_documents",
          "updated_at"
        ]);
    }

    function isClientOwnDocumentUpdate(clientId) {
      // Onboarding profile saves are authorized by the verified account mapping.
      // Do not depend on clients/{clientId}.uid because legacy invited records
      // may not have that field stamped yet.
      return signedIn()
        && !isArchivedClientData(resource.data)
        && hasAccount()
        && accountData().clientId == clientId;
    }

    function isClientUidClaim(clientId) {
      return signedIn()
        && (!("uid" in resource.data) || resource.data.uid == null || resource.data.uid == request.auth.uid)
        && resource.data.status == "invited"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "registered"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["uid", "status", "updated_at"])
        && existsAfter(accountPath(request.auth.uid))
        && isClientRole(getAfter(accountPath(request.auth.uid)).data.role)
        && getAfter(accountPath(request.auth.uid)).data.clientId == clientId;
    }

    match /accounts/{accountId} {
      allow get: if isOwnAccount(accountId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isClientSelfAccountWrite(accountId)
        || isAdminInviteAccountWrite(accountId)
        || isCanonicalAdminAccountWrite();
      allow update: if isCanonicalAdminAccountWrite()
        || isSafeSelfAccountUpdate(accountId)
        || isClientSelfAccountWrite(accountId);
      allow delete: if isAdmin();
    }

    match /client_invites/{tokenId} {
      // The invite token is an unguessable document ID. Users must already know
      // the token from an invite link before they can read it, which allows the
      // pre-auth signup screen to validate invite documents by exact token.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && (
          request.resource.data.expiresAt is timestamp
          || (
            request.resource.data.status == "pending"
            && request.resource.data.role == "admin"
            && request.resource.data.createdAt is timestamp
          )
        );
      allow delete: if isAdmin();
      // Claims stay scoped to this token document and may only update lifecycle
      // fields used by the signup claim transaction.
      allow update: if (
          request.auth != null
          && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == "admin"
        )
        || isInvitationLifecycleClaim(tokenId);
    }

    match /invitations/{tokenId} {
      allow get, list, create, delete: if isAdmin();
      allow update: if isAdmin() || isInvitationLifecycleClaim(tokenId);
    }

    match /clients/{clientId} {
      // Client reads are scoped to the authenticated account linked through
      // uid, account_id, or accounts/{uid}.clientId. The archive helper is
      // intentionally not evaluated here so sparse new client docs can load.
      allow get: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.uid == request.auth.uid
            || resource.data.account_id == request.auth.uid
            || get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.clientId == clientId
          )
        );
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Client writes accept either existing ownership stamps, incoming ownership
      // stamps, or the canonical accounts/{uid}.clientId mapping.
      allow update: if (isAdmin() && isOneWayAdminClientUpdate())
        || (
          request.auth != null
          && (
            resource.data.uid == request.auth.uid
            || resource.data.account_id == request.auth.uid
            || request.resource.data.uid == request.auth.uid
            || request.resource.data.account_id == request.auth.uid
            || get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.clientId == clientId
          )
        )
        || isClientUidClaim(clientId);
    }

    match /client_field_definitions/{fieldId} {
      allow get, list: if signedIn()
        && (isAdmin() || resource.data.active == true);
      allow create: if isAdmin()
        && request.resource.data.id == fieldId
        && request.resource.data.isCustom == true
        && request.resource.data.active == true;
      allow update: if isAdmin()
        && resource.data.isCustom == true
        && request.resource.data.isCustom == true;
      allow delete: if false;
    }

    match /programs/{document=**} {
      // Manager program views and assignment flows are admin-only under the
      // canonical lowercase role contract.
      allow read, write: if isAdmin();
    }

    match /program_templates/{document=**} {
      allow read, write: if isAdmin();
    }

    match /global_document_templates/{templateId} {
      // All signed-in users (managers and clients) may read active templates so they
      // can download blank forms from the client-facing Documents Tab.
      allow read: if signedIn();
      // Only admins may create, modify or remove global template records.
      allow create, update, delete: if isAdmin();
    }

    match /locations/{document=**} {
      allow read, write: if isAdmin();
    }

    match /events/{document=**} {
      allow read, write: if isAdmin();
    }

    match /automatic_notifications/{document=**} {
      allow read, write: if isAdmin();
    }

    match /todos/{document=**} {
      allow read, write: if isAdmin();
    }

    match /statistics/{document=**} {
      allow read, write: if isAdmin();
    }

    // Preserve manager access to the remaining operational collections while
    // keeping client accounts constrained to the explicit rules above.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
